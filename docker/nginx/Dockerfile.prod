FROM node:22-alpine AS production-assets

WORKDIR /var/www/html

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY vite.config.js ./
COPY resources ./resources
COPY public ./public
COPY scripts ./scripts

RUN npm run build && test ! -e public/hot

FROM nginx:1.27-alpine

COPY docker/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY public /var/www/html/public
COPY --from=production-assets /var/www/html/public/build /var/www/html/public/build

RUN rm -f /var/www/html/public/hot /var/www/html/public/storage \
    && ln -s /var/www/html/storage/app/public /var/www/html/public/storage
