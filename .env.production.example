APP_NAME="Online Competition KM"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://YOUR-DOMAIN.com

APP_LOCALE=th
APP_FALLBACK_LOCALE=th
APP_FAKER_LOCALE=th_TH

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

SUBMISSION_SESSION_PER_MINUTE=5
SUBMISSION_SESSION_PER_HOUR=20
SUBMISSION_IP_PER_MINUTE=30
SUBMISSION_IP_PER_HOUR=120
SUBMISSION_FORM_MINIMUM_SECONDS=2
SUBMISSION_FORM_TTL_MINUTES=120
SUBMISSION_FORM_LOCK_SECONDS=30
SUBMISSION_MAX_FILE_MEGABYTES=10
SUBMISSION_MAX_FILES=5
SUBMISSION_MAX_TOTAL_KILOBYTES=20480
SUBMISSION_MAX_REQUEST_KILOBYTES=25600

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=online_competition_km
DB_USERNAME=competition_user
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Required only for the first DatabaseSeeder run. Clear it after the account exists.
SUPER_ADMIN_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@competition.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Only Nginx is published. Change the bind address only when a host proxy requires it.
APP_HTTP_BIND=0.0.0.0
APP_HTTP_PORT=80

VITE_APP_NAME="${APP_NAME}"
