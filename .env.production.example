APP_NAME="Online Competition KM"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Set the real HTTPS origin after the TLS/reverse-proxy topology is known.
APP_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=online_competition_km
DB_USERNAME=competition_user
DB_PASSWORD=replace-with-application-password
DB_ROOT_PASSWORD=replace-with-root-password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Leave unset until HTTPS and proxy scheme detection are verified.
SESSION_SECURE_COOKIE=
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Internal HTTP ingress for a future same-host TLS reverse proxy.
APP_HTTP_BIND=127.0.0.1
APP_HTTP_PORT=8080

VITE_APP_NAME="${APP_NAME}"
